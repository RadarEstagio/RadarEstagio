# Avaliador de IA: "agy" para testes locais; "gemini_api" para a API direta.
AVALIADOR=agy
AGY_MODELO=gemini-3.6-flash-low
# Modelo do juiz de recomendações (outro modelo, de preferência de outra família)
JUIZ_MODELO=claude-sonnet-4-6
AGY_TIMEOUT_SEGUNDOS=300

# Adzuna (obrigatório para buscar vagas)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Gemini API (a chave só é obrigatória quando AVALIADOR=gemini_api)
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.6-flash
GEMINI_VAGAS_POR_LOTE=10
# Tempo máximo da extração por execução; esgotado, segue com o que já foi extraído
PRAZO_DA_EXTRACAO_SEGUNDOS=600

# Telegram (token do BotFather; o chat ID só é obrigatório quando DATABASE_URL está vazio)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Banco (string "Session pooler" do Supabase; vazio = perfil fixo, sem histórico)
DATABASE_URL=

# Link rastreável das vagas (Edge Function "ir"; vazio = link direto para a fonte)
URL_DE_RASTREIO=

# Webhook do vínculo (só quem administra o bot; segredo passado ao setWebhook do Telegram)
TELEGRAM_WEBHOOK_SECRET=

# Radar (a Gupy não precisa de chave)
FONTES=adzuna,gupy
DIAS_RECENTES=3
QUANTIDADE_VAGAS_ENVIADAS=7
NOTA_MINIMA=40
FALHAS_DE_ENVIO_ATE_PAUSAR=3
DIAS_DE_SILENCIO_ATE_AVISAR=7
DIAS_ATE_APAGAR_CONTA_EXCLUIDA=60
