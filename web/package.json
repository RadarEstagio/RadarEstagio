    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.28",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
